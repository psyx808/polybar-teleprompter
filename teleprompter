#!/usr/bin/env bash
t="/home/$USER/.news"
venv="/home/$USER/.venvs/rss_feedparser"

######################################################
# MODIFY THE VALUES BELOW TO ADAPT IT TO YOUR POLYBAR #
######################################################

speed="0.1"   # Teleprompter speed ⚡
next="0.5"  # Wait before next title jump ➡️
lenght="41"   # Number of characters lenght ↔️

venv(){
  mkdir -p "$(dirname "$venv")"
  if [ ! -d "$venv" ]; then
    python3 -m venv "$venv" || { echo "ERROR: $venv could not be created"; return 1; }
  fi

  if ! "$venv/bin/python" -c "import feedparser" 2>/dev/null; then
    "$venv/bin/python" -m pip install --quiet --upgrade pip
    "$venv/bin/python" -m pip install --quiet feedparser
  fi

  if [ ! -f "$t" ]; then
    echo "📰 Generating '$t' for the first time..."
    "$venv/bin/python" rss.py
  fi
}

venv

[ ! -f "$t" ] && echo "Not found: $t" && exit 1

g=(
  'ffffff' '01ffdc' '4DF527'
  '2bfbb5'  'fbdc2b' 'ff9d01'
  'f71d57'
)
x=0
next_color(){
  (( x = (x + 1) % ${#g[@]} ))
}

news_update(){
  local py
  if [ -x "$venv/bin/python" ]; then 
   py="$venv/bin/python"
  elif command -v python3 >/dev/null 2>&1; then 
    py="python3"
  else 
    py="python"; fi
  while true; do
    sleep 21600 # 6 hours (6 x 60 x 60)
    "$py" rss.py >/dev/null 2>&1
  done
}

news_update &
UPDATER_PID=$!

while read l; do
  a=0
  for (( i=0; i<${#l}; i++ )); do
    if (( i < $lenght )); then
      printf "%%{F#%s}%s%%{F-}\n" "${g[x]}" "${l:a:i-a+1}"
      next_color
      sleep $speed
    else
      (( a++ ))
      printf "%%{F#%s}%s%%{F-}\n" "${g[x]}" "${l:a:i-a+1}"
      next_color
      sleep $speed
    fi
  done
  a=0
  sleep $next
done < "$t"
